{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@aranlucas/oxforge/configs/recommended.json"],
  "rules": {
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-add-event-listener": "off",
    "anti-slop/no-module-mocking": "off",
    "eslint/no-console": [
      "error",
      {
        "allow": ["log", "error", "warn", "info"]
      }
    ]
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["**/interview-report.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    }
  ]
}
