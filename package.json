{
  "name": "angry-cat-pediatric-interviewer",
  "private": true,
  "scripts": {
    "typecheck": "pnpm --dir worker typecheck && pnpm --dir web typecheck",
    "lint": "pnpm --dir worker lint && pnpm --dir web lint",
    "dev": "pnpm --parallel --filter ./web --filter ./worker run dev",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "oxlint": "1.87.0",
    "portless": "0.15.7"
  }
}
