{
  "name": "angry-cat-pediatric-interviewer",
  "private": true,
  "scripts": {
    "typecheck": "pnpm --dir worker typecheck && pnpm --dir web typecheck",
    "lint": "pnpm --dir worker lint && pnpm --dir web lint",
    "dev": "pnpm --parallel --filter ./web --filter ./worker run dev",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint:oxforge": "oxlint"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.1.3",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7"
  },
  "packageManager": "pnpm@12.10.1"
}
