---
# LLVM 18 reports ArduinoJson's placement-new tagged union as leaked storage.
# arduino-audio-driver's CodecConfig constructor leaves signal_type for callers
# to set, which is safe here but trips the constructor-level analyzer check.
Checks: >-
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -clang-analyzer-optin.cplusplus.UninitializedObject
# Analyze only maintained application headers. Third-party codec and touch
# headers are version-pinned and checked by their upstream projects.
HeaderFilterRegex: '.*/src/(audio|interviewer)/.*'
...
