{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esp32-angry-cat",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "INTERVIEW_REPORTS",
      "bucket_name": "pediatric-oral-boards-reports",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PEDIATRIC_INTERVIEWER",
        "class_name": "PediatricInterviewer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AngryCat"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PediatricInterviewer"],
    },
    {
      // Angry Cat was removed; this permanently destroys its stored state.
      "tag": "v3",
      "deleted_classes": ["AngryCat"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
