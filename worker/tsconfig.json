{
  "compilerOptions": {
    "allowJs": false,
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "cloudflare.config.ts",
    "wrangler.config.ts",
    ".cloudflare/types/**/*.d.ts"
  ]
}
