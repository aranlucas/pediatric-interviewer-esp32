{
  "name": "angry-cat-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "deploy": "cf deploy",
    "dev": "cf dev",
    "generate-types": "wrangler types",
    "simulate:interview": "node tools/simulate-interview.mjs",
    "simulate:suite": "node tools/simulate-suite.mjs",
    "smoke:web": "node tools/smoke-web.mjs",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "agents": "^0.24.0",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "cf": "1.0.0-beta.10",
    "oxfmt": "^0.72.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.143.0",
    "ws": "^8.21.3"
  }
}
