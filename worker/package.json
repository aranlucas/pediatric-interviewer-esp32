{
  "name": "angry-cat-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck",
    "lint": "pnpm generate-types && oxlint .",
    "lint:fix": "pnpm generate-types && oxlint . --fix",
    "format": "oxfmt --config oxfmt.config.ts --write .",
    "format:check": "oxfmt --config oxfmt.config.ts --check .",
    "deploy": "cf deploy",
    "dev": "portless run --name api.pediatric-interviewer-esp32 cf dev",
    "generate-types": "cf workers types",
    "simulate:interview": "node tools/simulate-interview.mjs",
    "simulate:suite": "node tools/simulate-suite.mjs",
    "smoke:web": "vitest run --config vitest.smoke.config.ts",
    "test": "vitest run",
    "typecheck": "pnpm generate-types && tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p tools/tsconfig.json",
    "build": "cf build"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "agents": "^0.27.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "8.18.1",
    "cf": "1.0.0-beta.13",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
