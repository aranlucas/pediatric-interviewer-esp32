{
  "name": "angry-cat-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "deploy": "cf deploy",
    "dev": "portless run --name api.pediatric-interviewer-esp32 sh -c 'exec wrangler dev --experimental-new-config --ip 127.0.0.1 --port \"$PORT\"'",
    "generate-types": "cf workers types",
    "simulate:interview": "node tools/simulate-interview.mjs",
    "simulate:suite": "node tools/simulate-suite.mjs",
    "smoke:web": "node tools/smoke-web.mjs",
    "test": "vitest run",
    "typecheck": "pnpm generate-types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "cf build"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "agents": "^0.27.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "cf": "1.0.0-beta.13",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
