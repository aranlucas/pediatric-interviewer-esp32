{
  "name": "angry-cat-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm cf-typegen && next dev",
    "build": "pnpm cf-typegen && next build",
    "check": "pnpm lint && pnpm typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "preview": "pnpm build:worker && node tools/cloudflare.mjs dev",
    "deploy": "pnpm build:worker && cf deploy --prebuilt",
    "cf-typegen": "cf workers types",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "build:worker": "pnpm cf-typegen && node tools/cloudflare.mjs build"
  },
  "dependencies": {
    "agents": "^0.27.0",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/config": "0.24.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cf": "1.0.0-beta.13",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
