{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsx-a11y", "nextjs", "react", "typescript", "unicorn"],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    ".cloudflare/**",
    ".open-next/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "extends": [
    "../.oxlintrc.json",
    "../node_modules/@aranlucas/oxforge/configs/nextjs.json",
    "../node_modules/@aranlucas/oxforge/configs/vitest.json"
  ]
}
